function initializeGlobalTracking(userId, userName, userLevel, casualUserId, fechaCreacion, fechaRegistracion, abtests, serverPageViewId, countryCode, userTrim) {
  window.pageLoadStartTime = new Date().getTime();

  window.globalPageCounter = new Date().valueOf();
  try {
    // Will not work in Opera Mini or IE < 8
    globalPageCounter = 1 + parseInt(localStorage.getItem("globalPageCounter") || "0");
    localStorage.setItem("globalPageCounter", globalPageCounter);
    console.log('Geoloc from ip: <US>');
  } catch (err) {
  }

  window.pageViewId = serverPageViewId + "_" + globalPageCounter;

  var alephEndpoint = config.alephEndpoint.protocol + "://" + config.alephEndpoint.host;
  if (config.alephEndpoint.port)
    alephEndpoint += ":" + config.alephEndpoint.port;

  var noOpFunc = function () {
  };

  window.Aleph = window.Aleph || {};
  window.Aleph.serverUrl = alephEndpoint;
  window.Aleph.trackingEnabled = (config.alephTrackingEnabled || false) && true;
  window.Aleph.ClientTracker = window.Aleph.ClientTracker || { trackUserEvent: noOpFunc };
  window.Aleph.UserInfo = window.Aleph.UserInfo || { trackUserInfoAndTimeOnPage: noOpFunc };
  window.Aleph.currentUser = {
    id: userId,
    casualUserId: casualUserId || undefined,
    username: userName || undefined,
    fechaCreacion: fechaCreacion || undefined,
    fechaRegistracion: fechaRegistracion || undefined,
    level: userLevel,
    abtests: abtests,
    country: countryCode
  };

  if (userTrim) {
    window.Aleph.currentUser.userTrim = userTrim;
  }

  if (window.console) {
    console.log("CARGANDO PAGEVIEW", pageViewId, Aleph.currentUser);
  }
}

window.trackGAEvent = function(namespace, action, label, value, doNotAffectBounce) {
  if (window._gaq) {
    // ALl events send the last param 'opt_noninteraction' as true so that it doesn't affect bounce rate
    _gaq.push(['_trackEvent', namespace, action, label, value, true]);

    if (window.gtag) {
      window.gtag('event', action, {
        event_category: namespace,
        event_label: label,
        value: value,
        'non_interaction': !!doNotAffectBounce
      });
    }
  } else {
    console.log(`%cGA TRACKING %c${JSON.stringify([namespace, action, label, value])}`, 'font-size:16px;color: #0AA;', 'font-size: 12px;color: gray;')
  }
}

function setSessionVariable(name, value) {
  try {
    if (!sessionStorage.getItem(name)) {
      sessionStorage.setItem(name, value);
    }
  } catch (e) {
    console.warn(`There was a problem saving session var ` + name, e);
  }
}

