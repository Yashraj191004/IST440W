function createMockGlobalsUntilLoaded(methods) {
  _.each(methods, function(method) {
    window[method] = function() {
      globalLoading()

      var msg = "Method "+method+" was called before loaded. Queuing until it has been loaded.";
      Aleph.ClientTracker.trackUserEvent({type: 'warning', name: 'method-still-not-loaded', msg: msg});
      console.warn(msg)

      waitTimeout = setTimeout(function(){
        Aleph.ClientTracker.trackUserEvent({type: 'warning', name: 'method-still-not-loaded-timeout', msg: "Method "+method+" was called before loaded 15 seconds ago. Timeout."});
        endGlobalLoading()
      }, 15000)

      beforeLoadCallsQueue.push({method: method, timeout: waitTimeout})
    }
  })
}

function runQueuedOperationsOfMethod(method) {
  beforeLoadCallsQueue = _.filter(beforeLoadCallsQueue, function(operation) {
    if (operation.method === method) {
      console.warn("Calling deferred method "+method);
      clearTimeout(operation.timeout);
      window[method]();
      endGlobalLoading();
      return false
    }
    return true
  })
}

