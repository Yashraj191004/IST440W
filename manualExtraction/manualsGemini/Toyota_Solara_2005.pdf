,click-item,guides"><img class="Menu__item__img" src="https://static.startmycar.com/images/design2/icons/icon_guides.svg?v=d8703b"/><span class="Menu__item__text">Useful guides</span></a><a class="item reviews Menu__item" href="/toyota/solara/reviews" data-track-click="mainMenu,click-item,reviews"><img class="Menu__item__img" src="https://static.startmycar.com/images/design2/icons/icon_star-half.svg?v=462300"/><span class="Menu__item__text">Owner's reviews</span></a><a class="item comparar Menu__item" href="/toyota/solara/compare" data-track-click="mainMenu,click-item,comparar"><img class="Menu__item__img" src="https://static.startmycar.com/images/design2/icons/icon_compare.svg?v=5f0a7a"/><span class="Menu__item__text">Comparisons</span></a><a class="item search Menu__item" href="javascript:openSearchScreen();" data-track-click="mainMenu,click-item,search"><img class="Menu__item__img" src="https://static.startmycar.com/images/design2/icons/icon_search.svg?v=f7cc1f"/><span class="Menu__item__text">Search</span></a><a class="item help Menu__item" href="/help" data-track-click="mainMenu,click-item,help"><img class="Menu__item__img" src="https://static.startmycar.com/images/design2/icons/icon_help.svg?v=2cca22"/><span class="Menu__item__text">Help</span></a><!--div.Menu__item.text-center#menu-fb-share.fb-like(data-href=__('share.facebook.pageURL'), data-layout="button_count", data-action="like", data-show-faces="false", data-share="false")
--></div></div></div><script type="text/javascript">(function initializeMenu() {
  console.log("Loaded menu", new Date().getTime() - startLoadTime, "ms")
  var menuHideTimeout = 0;
  var menuIsOpened = false;

  window.openMenu = function openMenu()
  {
    if(!menuIsOpened) {
      menuIsOpened = true;
      clearTimeout(menuHideTimeout);
      $(".Menu .Menu__darkness").toggleClass("hidden", false)
      setTimeout(function() {
        $(".Menu").toggleClass("Menu--opened", true)
      }, 2);

      historyOpenDialog("menu");

      Aleph.ClientTracker.trackUserEvent({
        type: "modal",
        "namespace": "modalpage",
        "event": "modal-shown",
        "label": "mainMenu"
      });

      trackGAEvent("modalpage", "modal-shown", "mainMenu", null, true);

      // if (window.loadFBLikeBtn) {
      //   window.loadFBLikeBtn();
      // }
    }
  }

  window.openFixedMenu = function openFixedMenu(){
    menuIsOpened = true;
    $(".Menu .Menu__darkness").toggleClass("hidden", false)
    $(".Menu").toggleClass("Menu--opened", true)
  }

  window.closeMenu = function closeMenu() {
    if(menuIsOpened) {
      menuIsOpened = false;
      $(".Menu").toggleClass("Menu--opened", false);

      menuHideTimeout = setTimeout(function() {
        $(".Menu .Menu__darkness").toggleClass("hidden", true)
      }, 500);

      historyCloseDialog("menu");

      Aleph.ClientTracker.trackUserEvent({
        type: "modal",
        "namespace": "modalpage",
        "event": "modal-hidden",
        "label": "mainMenu"
      });
    }
  }

  window.loadSwitchCountryForm = function () {
    loadModalPage("/formswitchcountry");
  }

  historyOnBackButton("menu", window.closeMenu)

  $(".Menu__darkness").click(window.closeMenu)

  runQueuedOperationsOfMethod("openMenu")
  runQueuedOperationsOfMethod("openFixedMenu")
})()
</script></nav><div class="SearchScreen SearchScreen--closed js-searchscreen"><div class="SearchScreen__darkness"></div><div class="SearchScreen__screen"><div class="SearchScreen__bar FlexCentered FlexCentered--left FlexCentered--nowrap"><a class="LinkButton LinkButton--hover-enlarge" href="javascript:closeSearchScreen()"><img class="Icon Icon--left" src="https://static.startmycar.com/images/design2/icons/icon_arrowback.svg?v=2d7340"></a><input class="MaterialInput MaterialInput--searchscreen" id="searchbox" type="text" maxlength="1000" placeholder="Search problem..."><a class="LinkButton LinkButton--hover-enlarge" href="javascript:siteSearch()"><img class="Icon Icon--left" src="https://static.startmycar.com/images/design2/icons/icon_search--blue.svg?v=2e95b4"></a></div><div><div class="TitleGray">Popular searches</div><a class="LinkBlock" href="javascript:siteSearch(&quot;Radio&quot;)" data-track-click="search,click-popular,Radio"><img class="Icon Icon--left" src="https://static.startmycar.com/images/design2/icons/icon_trending--gray.svg?v=5245f1"><span class="align-middle">Radio</span></a><a class="LinkBlock" href="javascript:siteSearch(&quot;Clutch&quot;)" data-track-click="search,click-popular,Clutch"><img class="Icon Icon--left" src="https://static.startmycar.com/images/design2/icons/icon_trending--gray.svg?v=5245f1"><span class="align-middle">Clutch</span></a><a class="LinkBlock" href="javascript:siteSearch(&quot;Overheating&quot;)" data-track-click="search,click-popular,Overheating"><img class="Icon Icon--left" src="https://static.startmycar.com/images/design2/icons/icon_trending--gray.svg?v=5245f1"><span class="align-middle">Overheating</span></a><a class="LinkBlock" href="javascript:siteSearch(&quot;Fusebox&quot;)" data-track-click="search,click-popular,Fusebox"><img class="Icon Icon--left" src="https://static.startmycar.com/images/design2/icons/icon_trending--gray.svg?v=5245f1"><span class="align-middle">Fusebox</span></a></div></div></div><script type="text/javascript">(function initializeSeach() {
  console.log("Loaded search screen code ", new Date().getTime() - startLoadTime, "ms")
  var $searchScreen = $(".SearchScreen");var searchIsOpen = false;

  window.openSearchScreen = function openSearchScreen(popstateTriggered) {
    if(!searchIsOpen) {
      $searchScreen.toggleClass('SearchScreen--closed', false);
      searchIsOpen = true;
      $("#searchbox", $searchScreen).focus();

      historyOpenDialog("search");

      Aleph.ClientTracker.trackUserEvent({
        type: "modal",
        "namespace": "modalpage",
        "event": "modal-shown",
        "label": "searchScreen"
      });
      trackGAEvent("modalpage", "modal-shown", "searchScreen", null, true);
    }
  }

  window.closeSearchScreen = function closeSearchScreen(popstateTriggered) {
    if(searchIsOpen) {
      $searchScreen.toggleClass('SearchScreen--closed', true)
      searchIsOpen = false;

      Aleph.ClientTracker.trackUserEvent({
        type: "modal",
        "namespace": "modalpage",
        "event": "modal-hidden",
        "label": "searchScreen"
      });

      historyCloseDialog("search")
    }
  }

  // Needed for triggering close on back button in mobile
  historyOnBackButton("search", closeSearchScreen)

  window.siteSearch = function siteSearch(query) {
    if(!query) {
      query = $("input#searchbox").val();
      query = (query || "").trim();
    }

    if (query) {
      if (window.pageModelo) {
        makeAjaxPost('/utils/smart-search', {query: query, idModelo: pageModelo.idModelo});
      } else {
        makeAjaxPost('/utils/smart-search', {query: query});
      }

      trackGAEvent('useractions', 'search', query);
    } else {
      trackGAEvent('useractions', 'empty-search', query);
    }
  }

  $(".SearchScreen__darkness", $searchScreen).click(closeSearchScreen)

  $("#searchbox", $searchScreen).keyup(function(e) {
    if (e.which == 13) {
      siteSearch();
    } else if (e.which == 27) {
      closeSearchScreen();
    }
  });

  runQueuedOperationsOfMethod("openSearchScreen")
})()</script><script type="text/javascript">$(document).on("click", ".GlossaryRef[data-glossary-semantic]", function dataTrackClickHandler(e) {
  var semantic = $(this).data("glossary-semantic");
  var searchedtext = $(this).text();

  if (semantic && searchedtext) {
    loadModalPage("/modalglossary?semantic=" + encodeURIComponent(semantic) + "&searchedText=" + encodeURIComponent(searchedtext))
  }

  Aleph.ClientTracker.trackUserEvent({
    type: "click",
    namespace: "glossary",
    event: "tap-word",
    label: searchedtext
  });
});</script></div><div class="survey SmileySurvey offscreen notdisplayed screen-bottom-right" id="floating-survey"><div class="question"><p><strong>Did you find the website helpful?</strong></p></div><div class="thanks-msg"><p><strong>Thank you!</strong><br><br></p></div><div class="options"><span class="smiley smiley-sad" data-track-click="survey-2,click-smiley,sad"><div class="btn btn-mini btn-link">No!</div></span><span class="smiley smiley-neutral" data-track-click="survey-2,click-smiley,neutral"><div class="btn btn-mini btn-link">Meh...</div></span><span class="smiley smiley-happy" data-track-click="survey-2,click-smiley,happy"><div class="btn btn-mini btn-link">Yes!</div></span></div></div><script type="text/javascript">$(document).ready(function () {
  var $survey = $("#floating-survey");
  var SURVEY_MARK = "survey-2-replied";
  var SURVEY_SHOWN_MARK = "survey-2-shown";

  var timeForSurvey = userHasMark(SURVEY_SHOWN_MARK) ? 2000 : 60000;

  setTimeout(function() {
    // Future surveys will start right away
    setUserMark(SURVEY_SHOWN_MARK);

    if (!userHasMark(SURVEY_MARK)) {
      $survey.toggleClass("notdisplayed", false);
      setTimeout(function(){
        $survey.toggleClass("offscreen", false);
        Aleph.ClientTracker.trackUserEvent({
          type: "modal",
          "namespace": "survey-2",
          "event": "modal-shown",
          "label": "smileys"
        });
      }, 5);
    }
  }, timeForSurvey);

  $(".options .smiley", $survey).click(function(e) {
    $survey.toggleClass("replied", true);

    setTimeout(function() {
      $survey.toggleClass("offscreen", true);
      setTimeout(function(){
        $survey.toggleClass("notdisplayed", true);
      }, 1000)
    }, 750);

    loadModalPage("/formsurvey", function(err, $modal) {
      // Include survey choice in form data, useful to complement feedback
      var surveySelection = "?";
      var classes = e.currentTarget.classList;
      for(var i=0;i<classes.length;i++){
        if(classes[i].match("^smiley-")){
          surveySelection = classes[i].split('-')[1];
          break;
        }
      }
      $("#surveySelection", $modal).val(surveySelection);
    });

    setUserMark(SURVEY_MARK);
    return true;
  });
});</script></div><div id="react-modals"></div><div class="Footer"><div class="DesktopViewPort"><div class="text-center margin-top-small"><div class="FooterText margin-bottom">Browse site version for:</div><div>&nbsp;<form class="inline-block" action="/au/toyota/solara/info/manuals/2005?setSessionCountry=1" method="post"><a class="margin-small" href="javacript:void(0)" onclick="this.closest('form').submit();return false;"><img class="banderaPais" src="https://static.startmycar.com/images/banderas/au.png?v=909f70" title="Australia" alt="Australia"/></a></form><form class="inline-block" action="/ca/toyota/solara/info/manuals/2005?setSessionCountry=1" method="post"><a class="margin-small" href="javacript:void(0)" onclick="this.closest('form').submit();return false;"><img class="banderaPais" src="https://static.startmycar.com/images/banderas/ca.png?v=b62b5d" title="Canada" alt="Canada"/></a></form><form class="inline-block" action="/gb/toyota/solara/info/manuals/2005?setSessionCountry=1" method="post"><a class="margin-small" href="javacript:void(0)" onclick="this.closest('form').submit();return false;"><img class="banderaPais" src="https://static.startmycar.com/images/banderas/gb.png?v=5afd0a" title="Great Britain" alt="Great Britain"/></a></form><form class="inline-block" action="/nz/toyota/solara/info/manuals/2005?setSessionCountry=1" method="post"><a class="margin-small" href="javacript:void(0)" onclick="this.closest('form').submit();return false;"><img class="banderaPais" src="https://static.startmycar.com/images/banderas/nz.png?v=6a47ef" title="New Zealand" alt="New Zealand"/></a></form><form class="inline-block" action="/us/toyota/solara/info/manuals/2005?setSessionCountry=1" method="post"><a class="margin-small" href="javacript:void(0)" onclick="this.closest('form').submit();return false;"><img class="banderaPais" src="https://static.startmycar.com/images/banderas/us.png?v=f4e744" title="United States" alt="United States"/></a></form><form class="inline-block" action="/za/toyota/solara/info/manuals/2005?setSessionCountry=1" method="post"><a class="margin-small" href="javacript:void(0)" onclick="this.closest('form').submit();return false;"><img class="banderaPais" src="https://static.startmycar.com/images/banderas/za.png?v=239c94" title="South Africa" alt="South Africa"/></a></form></div><div class="LineGray margin-top"></div></div><div class="text-center my-1"><a class="LinkButton LinkButton--gray" href="https://www.opinautos.com"><img class="LinkButton__icon" src="https://static.startmycar.com/images/banderas/es.png?v=fc29fb"/><span>Español</span></a><a class="LinkButton LinkButton--gray" href="https://www.opinautos.com.br"><img class="LinkButton__icon" src="https://static.startmycar.com/images/banderas/br.png?v=7a0381"/><span>Português</span></a><div class="LineGray margin-top"></div></div><div class="LeftRightBox"><div class="LeftRightBox__left margin"><div class="FooterText">©2026 Rewise&nbsp;Inc.</div></div><div class="LeftRightBox__right margin"><!--a(href="javascript:void(0)").LinkButton.LinkButton--gray!= __('home.linkTermsAndConditions')--><!--a(href="javascript:void(0)").LinkButton.LinkButton--gray!= __('home.linkPrivacyPolicy')--><a class="LinkButton LinkButton--gray" href="/help">Help</a><a class="LinkButton LinkButton--gray" href="/privacy-policy">Privacy</a><a class="LinkButton LinkButton--gray" href="/terms-of-use">Terms</a><a class="LinkButton LinkButton--gray" href="javascript:loadModalPage('/feedbackform');">Feedback</a><a class="LinkButton LinkButton--gray" href="mailto:media@opinautos.com">Publish with us</a></div></div></div></div><script type="text/javascript">function mostrarError(errorHtml, errorTitle){
  var $okButton = $("<div data-dismiss='modal' class='Button'>").text("Ok")
  var $errorDialog = $("<div class='MsgDialog MsgDialog--error'>");
  $errorDialog.append($("<div class='MsgDialog__title'>").text(errorTitle || clientMessages.thereWasAProblem));
  $errorDialog.append($("<div class='MsgDialog__msg max-width-400'>").html(errorHtml));
  $errorDialog.append($("<div class='MsgDialog__buttons'>").append($okButton));

  opidialog.openFromDom("mostrarError", $errorDialog)
}

function mostrarMensaje(html, title) {
  var $msgDialog = $("<div class='MsgDialog'>");
  if(title) {
    $msgDialog.append($("<div class='MsgDialog__title'>").text(title));
  }
  $msgDialog.append($("<div class='MsgDialog__msg'>").html(html));
  var $okButton = $("<div data-dismiss='modal' class='Button'>").text("Ok")
  $msgDialog.append($("<div class='MsgDialog__buttons'>").append($okButton));

  opidialog.openFromDom("mostrarMensaje", $msgDialog)
}

function validationProblemsMsg(){
  mostrarError(clientMessages.checkAllFields, " ")
}

function mostrarLogin(optionalEmail, optionalFromPath) {
  loadModalPage("/formloginregister", function(err, $modalHtml) {
    if (optionalEmail) {
      $('input[name=email]', $modalHtml).val(optionalEmail);
      $('input[name=password]', $modalHtml).focus();
    } else if (window.innerWidth >= 800 && window.innerHeight >= 600) {
      // Only do this in desktop screens, as in mobile hides part of the modal
      $('input[name=email]', $modalHtml).focus();
    }

    if(optionalFromPath) {
      $('input[name=redirect]', $modalHtml).val(optionalFromPath);
    }
  });
}

function openDataFeedback(dataType) {
  loadModalPage("/feedbackform", function (err, $modal) {
    // Re-style the modal for fusebox feedback
    $(".MsgDialog__title", $modal).text("Did you find any kind of error in the data?");
    $("#contenido", $modal).attr("placeholder", "Tell us what we should fix or improve...");

    // Hide email to make it less intrusive
    $(".js-contact-info", $modal).hide();

    // Set modal type so this kind of feedback can be differentiated from regular feedback
    $("#feedbackContext", $modal).
      val(JSON.stringify({ modalType: "dataFeedback", dataType: dataType }));

    $("#contenido").focus();
  });
}
</script><script type="text/javascript">var msgs = [];

if (msgs.length > 0) {
  mostrarMensaje(msgs[0].body, msgs[0].title || '')
}
</script><script type="text/javascript">function logout(){
  makeAjaxGet("/logout", getDefaultGetHandler());
}

function fixOauthLoginButtonsHrefs(){
  //-TODO: Esto no anda si hay un reload por ajax, ya que esta parte de la página no suele recargarse
  //- y puede haber nuevo código con botones similares a este.

  //- Set redirect URL if empty with current page (note the exact match of href)
  var registerUrl = "/auth/register/facebook?redirecturl="+encodeURIComponent(document.location.pathname);
  $('a.js-btn-fb-signup[href="/auth/register/facebook?redirecturl="]').attr("href", registerUrl);

  var loginUrl = "/auth/login/facebook?redirecturl="+encodeURIComponent(document.location.pathname);
  $('a.js-btn-fb-login[href="/auth/login/facebook?redirecturl="]').attr("href", loginUrl);

  //- If the register button has a registration context, set the query param in the callback
  var $registerBtn = $('a.js-btn-fb-signup[href*="/auth/register/facebook?redirecturl="]');
  var registrationCtx = $registerBtn.data('registration-ctx')
  if (registrationCtx) {
    $registerBtn.attr('href', $registerBtn.attr('href') + '&registrationctx=' + encodeURIComponent(registrationCtx));
  }
}

onDocumentReady(function($dom){
  $(document).on('click', '.image-box', function(e){
    if(!$(this).hasClass('uploading')) {
      var imgId = $(this).data('image-url');
      var imgPreviewUrl = $(this).data('image-preview-url');
      // Set width and height so the popup has the right size
      var w = $(this).data('image-width');
      var h = $(this).data('image-height');

      var $img = $("<img>", {src: imgPreviewUrl, "class": 'ImageFullScreen'});
      var $original = $("<div>").append($("<a>", {text: "View original", target: "_blank", href: imgId, 'class': 'LinkButton'}));
      /*var $placeholder = $("<div>", {position: 'relative', height: 0, 'padding-bottom': (h/w*100)+"%"});
      $placeholder.append($("<div>", {
        position: 'absolute',
        height: h+'px',
        width: w+'px',
        background: "red",
        top: 0,
        left: 0,
        'padding-bottom': (h/w*100)+'%'
      }));


      // Once the image is loaded, remove width and height attrs just in case they are wrong
      $img.load(function() {
        $placeholder.remove();
      })
      $dialog = $("<div>").append($placeholder).append($img)
      */
      opidialog.openFromDom("zoomImage-" + imgId, $("<div>", {style: 'text-align: center;'}).append($img).append($original));
    }
    e.preventDefault();
  });

  //- Track facebook logins/registrations
  var loginClicked = false;
  $(".js-btn-fb-login").on("click", function(){
    if(loginClicked){
      console.log("Blocked second click");
      return false;
    }
    loginClicked = true;
    setTimeout(function(){
      loginClicked = false;
    }, 5000);
     trackGAEvent('useractions', 'login', 'click-facebook');
  });

  var registerClicked = false;
  $(".js-btn-fb-signup").on("click", function(){
    if(registerClicked){
      console.log("Blocked second click");
      return false;
    }
    registerClicked = true;
    setTimeout(function(){
      registerClicked = false;
    }, 5000);
    trackGAEvent('useractions', 'oauth', 'click-register-facebook');
  });

  fixOauthLoginButtonsHrefs();
});</script></body></html>