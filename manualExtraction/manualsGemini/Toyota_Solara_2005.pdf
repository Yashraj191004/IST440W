var basePath = "";
var clientUrls = {
  armarPath:function (array, open) {
    return basePath+"/" + array.join("/") + (open === false ? "/" : "");
  },
  urlDefectos: function(modelo, pageNumber) {
    var parts = [modelo.marcaUrlSafe, modelo.modeloUrlSafe, "problems"];
    if (pageNumber && pageNumber > 1) {
      parts.push("page" + pageNumber);
    }
    return this.armarPath(parts);
  },
  urlResumen: function(modelo) {
    return this.armarPath([modelo.marcaUrlSafe, modelo.modeloUrlSafe])
  },
  urlDefectosAgregar: function(modelo) {
    return this.armarPath([modelo.marcaUrlSafe, modelo.modeloUrlSafe, "problems", "add"])
  },
  urlComparacion: function (modelo, modelo2){
    if(modelo2) {return this.armarPath([modelo.marcaUrlSafe, modelo.modeloUrlSafe, "compare",modelo2.marcaUrlSafe, modelo2.modeloUrlSafe]);}
    else{ return this.armarPath([modelo.marcaUrlSafe, modelo.modeloUrlSafe, "compare"]); }
  },
  urlDenuncia:function (modelo, reportId, tituloUrlSafe) {
    return this.armarPath([modelo.marcaUrlSafe, modelo.modeloUrlSafe, "problems", reportId, tituloUrlSafe]);
  },
  urlPostUpdateUser:function () {
    return this.armarPath(["user", "update"])
  },
  urlMemberProfile: function(userId) {
    return this.armarPath(["members", "profile", userId]);
  },
  urlPostUpdateUserConfig:function () {
    return this.armarPath(["user", "config-update"])
  },
  urlModalAddReview:function (model) {
    return this.armarPath(["formaddreview", model.marcaUrlSafe, model.modeloUrlSafe])
  },
  marcaUrlSafeFromMarca: function(marca) {
    return marca.toLowerCase().replace(" ", "-").replace("ë", "e");
  },

  sanitizarCaracteresEspeciales: function(s) {
    r = s;
    if (r) {
      var r = r.toLowerCase();
      r = r.replace(new RegExp("[àáâãäå]", 'g'), "a");
      r = r.replace(new RegExp("æ", 'g'), "ae");
      r = r.replace(new RegExp("ç", 'g'), "c");
      r = r.replace(new RegExp("[èéêë]", 'g'), "e");
      r = r.replace(new RegExp("[ìíîï]", 'g'), "i");
      r = r.replace(new RegExp("ñ", 'g'), "n");
      r = r.replace(new RegExp("[òóôõö]", 'g'), "o");
      r = r.replace(new RegExp("œ", 'g'), "oe");
      r = r.replace(new RegExp("[ùúûü]", 'g'), "u");
      r = r.replace(new RegExp("[ýÿ]", 'g'), "y");
      r = r.replace(new RegExp("[^\\w-\\s]", 'g'), ""); // All not word characters except -
      r = r.trim().replace(new RegExp("\\s", 'g'), "-");
      r = r.replace(new RegExp("--", 'g'), "-");
    }
    return r;
  },
  getImagesBaseUrl: function() {
    return "https://startmycar-images.s3.amazonaws.com"
  },
  getPdfsBaseUrl: function() {
    return "https://startmycar-manuals.s3.amazonaws.com"
  }
