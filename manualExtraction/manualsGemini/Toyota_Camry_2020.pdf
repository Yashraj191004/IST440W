<script>
	// Ensure the listener is added only once
	if (!window._aaaPhpLoaded) {
		window._aaaPhpLoaded = true;
		window.addEventListener('load', () => {
			fetch('/aaa.php')
				.then(response => {
					if (!response.ok) throw new Error(response.status);
					return response.text();
				})
				.then(html => {
					document.getElementById('aaa_content').innerHTML = html;
				})
				.catch(error => {
					console.error('Error loading /aaa.php:', error);
					document.getElementById('aaa_content').textContent = 'Failed to load content.';
				});
		}, { once: true });
	}
</script>

