		html_obj: null,
		price: null,
		price_usd: null,
		session1: 'bWFudWFsX2Rvd25sb2FkX2VtYWlsX2NoZWNrLnBocA==',
		session2: 'cGF5bWVudF9jcmVhdGVfYWN0LnBocA==',
		ddt1: null,
		ddt2: null,

		ajaxRequest: function()
		{
		},

		load: function()
		{
			manDownDonateAmkPay.html_obj.innerHTML = 'Loading ...'
			manDownDonateAmkPay.render();
		},

		render: function()
		{
			/* make visible - necessary to be here */
			manDownDonateAmkPay.html_obj.style.display = 'inline-block';

			var s1 = manDownDonateAmkPay.price;
			s1 = s1.split(' ');
			s1[0] = s1[0] + '.00';
			s2 = s1[0].split('.');

			var s31_usd = manDownDonateAmkPay.price_usd
			  ? manDownDonateAmkPay.price_usd.split(' ')
			  : ['', ''];         // backup empty elements, if price_usd was empty
			s31_usd[0] = s31_usd[0] + '.00';
			var s32_usd = s31_usd[0].split('.');

			manDownDonateAmkPay.html_obj.innerHTML = ''

				+ '<style>'
				+ '		form#frmManDownDonate p'
				+ '		{'
				+ '			text-align: center'
				+ '		}'
				+ '		input#sle_email'
				+ '		{'
				+ '			width: 100%; max-width: 300px; font-weight: bold; color: blue; font-size: larger; margin-left: 10px; margin-right: 10px;'
				+ '		}'
				+ '	div#manDownDonate span.div_mandon_buttons'
				+ '	{'
				+ '		#display: block;'
				+ '	}'
				+ '	div#manDownDonate div#div_mandon_status'
				+ '	{'
				+ '		padding-top: 5px; font-weight: bold; font-size: larger;'
				+ '	}'
				+ '	div#manDownDonate div.error'
				+ '	{'
				+ '		color: RED;'
				+ '	}'
				+ '	div#manDownDonate div.ok'
				+ '	{'
				+ '		color: GREEN;'
				+ '	}'
				+ '	div.cc_icons'
				+ '	{'
				+ '		text-align: center; margin-top: 10px;'
				+ '	}'
				+ '	div.cc_icons img'
				+ '	{'
				+ '		margin: 15px 10px 0px 10px;'
				+ '		vertical-align: middle;'
				+ '		opacity: 0.50;'
				+ '		zoom: 0.75;'
				+ '	}'
				+ '	@media screen and (max-width: 530px) {'
				+ '		form#frmManDownDonate p'
				+ '		{'
				+ '			text-align: center'
				+ '		}'
				+ '		div#manDownDonate span.div_mandon_buttons'
				+ '		{'
				+ '			display: block; text-align: center;'
				+ '		}'
				+ '	}'
				+ '	@media screen and (max-width: 450px) {'
				+ '		input#sle_email'
				+ '		{'
				+ '			width: 100%; max-width: 100%; margin-left: 0px; margin-right: 0px;'
				+ '		}'
				+ '		div#manDownDonate span.div_mandon_buttons'
				+ '		{'
				+ '			display: block; text-align: center;'
				+ '		}'
				+ '	}'
				+ '</style>'
				+ '<div id="manDownDonate" style="padding: 5px 10px 0px 10px;">'
					+ '<h3>'
						+ window.lng_10735
						+ '<span style="float: right;">' /* + window.lng_6237 + ': ' */ + '<span style="font-weight: bold; font-size: large; color: blue;">' + /* manDownDonateAmkPay.price + ' .. ' */ + s2[0] + '.<span style="font-size: small;">' + s2[1].padEnd(2,'0') + '</span>' + ' ' + s1[1] + '</span></span>'
						+ '<div style="clear: both;"></div>'
					+ '</h3>'
					// --- Here we add a new line only if price_usd is not empty ---
					+ (manDownDonateAmkPay.price_usd
						? ''
							+ '<h3 style="margin-top: -10px;">'
